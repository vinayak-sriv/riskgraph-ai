{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riskgraph.ai/contracts/validation/http-validation-test.schema.json",
  "title": "HTTP Validation Test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_base_url",
    "method",
    "path",
    "auth_context",
    "expected_status"
  ],
  "properties": {
    "target_base_url": {
      "type": "string",
      "pattern": "^https?://(localhost|127\\.0\\.0\\.1|host\\.docker\\.internal|sandbox-app|sandbox-[a-zA-Z0-9_.-]+)(:[0-9]+)?$"
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "auth_context": {
      "type": "string",
      "enum": ["ANONYMOUS", "USER", "ADMIN"]
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "body": {
      "type": ["object", "array", "string", "null"]
    },
    "expected_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    }
  }
}
