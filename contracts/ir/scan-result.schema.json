{
  "$defs": {
    "ComponentScore": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weighted_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weighted Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "weight",
        "weighted_score"
      ],
      "title": "ComponentScore",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "CAN_ACCESS",
            "CALLS",
            "READS",
            "WRITES",
            "REQUIRES_ROLE",
            "CONNECTS_TO",
            "RETURNS",
            "HAS_ROLE"
          ],
          "title": "Relationship",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "relationship"
      ],
      "title": "Edge",
      "type": "object"
    },
    "GraphDelta": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "$ref": "#/$defs/SecurityGraph"
        },
        "after": {
          "$ref": "#/$defs/SecurityGraph"
        },
        "new_paths": {
          "items": {
            "$ref": "#/$defs/PathEvidence"
          },
          "title": "New Paths",
          "type": "array"
        },
        "removed_paths": {
          "items": {
            "$ref": "#/$defs/PathEvidence"
          },
          "title": "Removed Paths",
          "type": "array"
        }
      },
      "required": [
        "before",
        "after",
        "new_paths",
        "removed_paths"
      ],
      "title": "GraphDelta",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "node_type": {
          "enum": [
            "USER",
            "ROLE",
            "ENDPOINT",
            "CONTROLLER",
            "FUNCTION",
            "SERVICE",
            "DATABASE",
            "DATA_RESOURCE",
            "EXTERNAL_SERVICE"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "node_type",
        "name"
      ],
      "title": "Node",
      "type": "object"
    },
    "PathEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "type": "string"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "source",
        "target",
        "nodes",
        "edges"
      ],
      "title": "PathEvidence",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": "HIGH",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "coverage_ratio": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Ratio",
          "type": "number"
        },
        "incomplete": {
          "default": false,
          "title": "Incomplete",
          "type": "boolean"
        }
      },
      "title": "Quality",
      "type": "object"
    },
    "RiskComponents": {
      "additionalProperties": false,
      "properties": {
        "reachability": {
          "$ref": "#/$defs/ComponentScore"
        },
        "authorization_change": {
          "$ref": "#/$defs/ComponentScore"
        },
        "data_sensitivity": {
          "$ref": "#/$defs/ComponentScore"
        },
        "external_exposure": {
          "$ref": "#/$defs/ComponentScore"
        },
        "privilege_impact": {
          "$ref": "#/$defs/ComponentScore"
        },
        "exploitability": {
          "$ref": "#/$defs/ComponentScore"
        }
      },
      "required": [
        "reachability",
        "authorization_change",
        "data_sensitivity",
        "external_exposure",
        "privilege_impact",
        "exploitability"
      ],
      "title": "RiskComponents",
      "type": "object"
    },
    "RiskResult": {
      "additionalProperties": false,
      "properties": {
        "risk_before": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Before",
          "type": "integer"
        },
        "risk_after": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk After",
          "type": "integer"
        },
        "risk_delta": {
          "maximum": 100,
          "minimum": -100,
          "title": "Risk Delta",
          "type": "integer"
        },
        "category_before": {
          "enum": [
            "LOW",
            "MODERATE",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Category Before",
          "type": "string"
        },
        "category_after": {
          "enum": [
            "LOW",
            "MODERATE",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Category After",
          "type": "string"
        },
        "components": {
          "$ref": "#/$defs/RiskComponents"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "components_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskComponents"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_version": {
          "default": "1.0.0",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "risk_before",
        "risk_after",
        "risk_delta",
        "category_before",
        "category_after",
        "components",
        "evidence"
      ],
      "title": "RiskResult",
      "type": "object"
    },
    "SecurityGraph": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "SecurityGraph",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "graph_delta": {
      "$ref": "#/$defs/GraphDelta"
    },
    "risk_result": {
      "$ref": "#/$defs/RiskResult"
    },
    "verdict": {
      "enum": [
        "ALLOW",
        "REVIEW",
        "BLOCK"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "quality": {
      "$ref": "#/$defs/Quality"
    },
    "scan_id": {
      "type": "string"
    },
    "analysis_id": {
      "type": "string"
    },
    "analyzer_version": {
      "type": "string"
    },
    "analyzer_config_hash": {
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "DEGRADED"
      ]
    },
    "pre_validation_verdict": {
      "enum": [
        "ALLOW",
        "REVIEW",
        "BLOCK"
      ]
    },
    "final_verdict": {
      "enum": [
        "ALLOW",
        "REVIEW",
        "BLOCK"
      ]
    },
    "validation_status": {
      "enum": [
        "CONFIRMED",
        "REJECTED",
        "INCONCLUSIVE",
        "NOT_RUN",
        "ERROR"
      ]
    },
    "provenance": {
      "$ref": "analysis-envelope.schema.json#/properties/provenance"
    },
    "coverage": {
      "$ref": "analysis-envelope.schema.json#/properties/coverage"
    },
    "diagnostics": {
      "$ref": "analysis-envelope.schema.json#/properties/diagnostics"
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "analysis-envelope.schema.json#/$defs/evidenceList"
        },
        "after": {
          "$ref": "analysis-envelope.schema.json#/$defs/evidenceList"
        }
      }
    },
    "ai": {
      "$ref": "../ai/explanation.schema.json"
    },
    "sandbox_demonstration": {
      "$ref": "../validation/sandbox-result.schema.json"
    },
    "validation": {
      "$ref": "../validation/sandbox-result.schema.json"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "route_id",
          "method",
          "path",
          "resource",
          "severity",
          "dependency_path",
          "evidence",
          "ai",
          "validation"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "LOW",
              "MODERATE",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "dependency_path": {
            "$ref": "#/$defs/PathEvidence"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "ai": {
            "$ref": "../ai/explanation.schema.json"
          },
          "validation": {
            "$ref": "../validation/sandbox-result.schema.json"
          }
        }
      }
    }
  },
  "required": [
    "scenario",
    "graph_delta",
    "risk_result",
    "verdict",
    "scan_id",
    "analysis_id",
    "analyzer_config_hash",
    "provenance",
    "source_evidence",
    "coverage",
    "diagnostics",
    "pre_validation_verdict",
    "final_verdict",
    "validation_status",
    "status",
    "findings"
  ],
  "title": "AnalysisResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riskgraph.ai/contracts/ir/scan-result.schema.json"
}
