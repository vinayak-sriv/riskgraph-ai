{
  "$defs": {
    "ComponentScore": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weighted_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weighted Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "weight",
        "weighted_score"
      ],
      "title": "ComponentScore",
      "type": "object"
    },
    "RiskComponents": {
      "additionalProperties": false,
      "properties": {
        "reachability": {
          "$ref": "#/$defs/ComponentScore"
        },
        "authorization_change": {
          "$ref": "#/$defs/ComponentScore"
        },
        "data_sensitivity": {
          "$ref": "#/$defs/ComponentScore"
        },
        "external_exposure": {
          "$ref": "#/$defs/ComponentScore"
        },
        "privilege_impact": {
          "$ref": "#/$defs/ComponentScore"
        },
        "exploitability": {
          "$ref": "#/$defs/ComponentScore"
        }
      },
      "required": [
        "reachability",
        "authorization_change",
        "data_sensitivity",
        "external_exposure",
        "privilege_impact",
        "exploitability"
      ],
      "title": "RiskComponents",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "risk_before": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Before",
      "type": "integer"
    },
    "risk_after": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk After",
      "type": "integer"
    },
    "risk_delta": {
      "maximum": 100,
      "minimum": -100,
      "title": "Risk Delta",
      "type": "integer"
    },
    "category_before": {
      "enum": [
        "LOW",
        "MODERATE",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Category Before",
      "type": "string"
    },
    "category_after": {
      "enum": [
        "LOW",
        "MODERATE",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Category After",
      "type": "string"
    },
    "components": {
      "$ref": "#/$defs/RiskComponents"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "components_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskComponents"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_version": {
      "default": "1.0.0",
      "title": "Policy Version",
      "type": "string"
    }
  },
  "required": [
    "risk_before",
    "risk_after",
    "risk_delta",
    "category_before",
    "category_after",
    "components",
    "evidence"
  ],
  "title": "RiskResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riskgraph.ai/contracts/ir/risk-result.schema.json"
}
