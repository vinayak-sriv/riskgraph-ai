{
  "$defs": {
    "ComponentScore": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weighted_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Weighted Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "weight",
        "weighted_score"
      ],
      "title": "ComponentScore",
      "type": "object"
    },
    "FindingRiskResult": {
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "risk_before": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Before",
          "type": "integer"
        },
        "risk_after": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk After",
          "type": "integer"
        },
        "risk_delta": {
          "maximum": 100,
          "minimum": -100,
          "title": "Risk Delta",
          "type": "integer"
        },
        "category_before": {
          "enum": [
            "LOW",
            "MODERATE",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Category Before",
          "type": "string"
        },
        "category_after": {
          "enum": [
            "LOW",
            "MODERATE",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Category After",
          "type": "string"
        },
        "components": {
          "$ref": "#/$defs/RiskComponents"
        },
        "components_before": {
          "$ref": "#/$defs/RiskComponents"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "resource_id",
        "risk_before",
        "risk_after",
        "risk_delta",
        "category_before",
        "category_after",
        "components",
        "components_before",
        "evidence",
        "policy_version"
      ],
      "title": "FindingRiskResult",
      "type": "object"
    },
    "RiskBand": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "LOW",
            "MODERATE",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Category",
          "type": "string"
        },
        "minimum": {
          "maximum": 100,
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        },
        "maximum": {
          "maximum": 100,
          "minimum": 0,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "minimum",
        "maximum"
      ],
      "title": "RiskBand",
      "type": "object"
    },
    "RiskComponents": {
      "additionalProperties": false,
      "properties": {
        "reachability": {
          "$ref": "#/$defs/ComponentScore"
        },
        "authorization_change": {
          "$ref": "#/$defs/ComponentScore"
        },
        "data_sensitivity": {
          "$ref": "#/$defs/ComponentScore"
        },
        "external_exposure": {
          "$ref": "#/$defs/ComponentScore"
        },
        "privilege_impact": {
          "$ref": "#/$defs/ComponentScore"
        },
        "exploitability": {
          "$ref": "#/$defs/ComponentScore"
        }
      },
      "required": [
        "reachability",
        "authorization_change",
        "data_sensitivity",
        "external_exposure",
        "privilege_impact",
        "exploitability"
      ],
      "title": "RiskComponents",
      "type": "object"
    },
    "RiskPolicyMetadata": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights",
          "type": "object"
        },
        "review_after": {
          "maximum": 100,
          "minimum": 0,
          "title": "Review After",
          "type": "integer"
        },
        "block_after": {
          "maximum": 100,
          "minimum": 0,
          "title": "Block After",
          "type": "integer"
        },
        "review_delta": {
          "maximum": 100,
          "minimum": 0,
          "title": "Review Delta",
          "type": "integer"
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/RiskBand"
          },
          "title": "Bands",
          "type": "array"
        }
      },
      "required": [
        "version",
        "weights",
        "review_after",
        "block_after",
        "review_delta",
        "bands"
      ],
      "title": "RiskPolicyMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "risk_before": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Before",
      "type": "integer"
    },
    "risk_after": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk After",
      "type": "integer"
    },
    "risk_delta": {
      "maximum": 100,
      "minimum": -100,
      "title": "Risk Delta",
      "type": "integer"
    },
    "category_before": {
      "enum": [
        "LOW",
        "MODERATE",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Category Before",
      "type": "string"
    },
    "category_after": {
      "enum": [
        "LOW",
        "MODERATE",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Category After",
      "type": "string"
    },
    "components": {
      "$ref": "#/$defs/RiskComponents"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "components_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskComponents"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_version": {
      "default": "1.0.0",
      "title": "Policy Version",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/RiskPolicyMetadata"
    },
    "finding_results": {
      "items": {
        "$ref": "#/$defs/FindingRiskResult"
      },
      "title": "Finding Results",
      "type": "array"
    }
  },
  "required": [
    "risk_before",
    "risk_after",
    "risk_delta",
    "category_before",
    "category_after",
    "components",
    "evidence",
    "policy"
  ],
  "title": "RiskResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riskgraph.ai/contracts/ir/risk-result.schema.json"
}
