# Database
POSTGRES_DB=riskgraph
POSTGRES_USER=riskgraph
POSTGRES_PASSWORD=riskgraph_dev_password
DATABASE_URL=postgresql://riskgraph:riskgraph_dev_password@postgres:5432/riskgraph
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/riskgraph

# Ollama
# Default local setup:
# OLLAMA_BASE_URL=http://localhost:11434
#
# Kali VM setup:
# 1. Start Ollama on Kali:
#    OLLAMA_HOST=0.0.0.0:11434 ollama serve
# 2. Confirm reachability:
#    curl http://<kali-vm-ip>:11434/api/tags
# 3. Set the service URL:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Service URLs inside Docker Compose
VITE_PLATFORM_API_BASE_URL=http://localhost:8080
DASHBOARD_ORIGIN=http://localhost:5173
JAVA_ANALYZER_BASE_URL=http://java-analyzer:8081
GRAPH_RISK_BASE_URL=http://graph-risk-service:8082
AI_VALIDATION_BASE_URL=http://ai-validation-service:8083
RISKGRAPH_SERVICE_TOKEN=replace_with_a_random_32_byte_or_longer_value
RISKGRAPH_MAX_CONCURRENT_ANALYSES=2
RISKGRAPH_MAX_QUEUED_ANALYSES=4
RISKGRAPH_ANALYZER_PROCESS_ISOLATION=true
RISKGRAPH_LOGIN_MAX_FAILURES=5
RISKGRAPH_LOGIN_IP_MAX_FAILURES=50
RISKGRAPH_LOGIN_WINDOW_SECONDS=300
RISKGRAPH_LOGIN_BLOCK_SECONDS=60
RISKGRAPH_MAX_DEPENDENCY_RESPONSE_BYTES=33554432
RISKGRAPH_AI_MAX_CONCURRENCY=2
RISKGRAPH_AI_QUEUE_TIMEOUT_SECONDS=5
RISKGRAPH_VALIDATION_PROBE_IMAGE=python:3.12.14-alpine3.24@sha256:b64631e04e4920160c50fbe8d8df828f7f35f06f425cb44aa09bca53e708a35a

# Host directory made available read-only to the analyzer container.
ANALYZER_REPOSITORY_ROOT=../samples/generated
RISKGRAPH_MAX_JAVA_FILES=5000
RISKGRAPH_MAX_JAVA_FILE_BYTES=2097152
RISKGRAPH_MAX_TOTAL_JAVA_BYTES=52428800
RISKGRAPH_MAX_ANALYSIS_SECONDS=60
# Optional override for the versioned resource-classification policy.
# RISKGRAPH_SENSITIVITY_POLICY=C:\path\to\sensitivity-policy.yml

# Native prototype defaults (Compose sets its own service URLs and repository path).
# SPRING_PROFILES_ACTIVE=local
# RISKGRAPH_ALLOWED_REPOSITORY_ROOTS=C:\Users\you\project\samples\generated
# RISKGRAPH_SANDBOX_MANIFEST=./samples/generated/mvp-v1/manifest.json
# RISKGRAPH_RISK_POLICY=./services/graph-risk-service/app/policy-v1.yml
# For Compose with Ollama on the host use http://host.docker.internal:11434.

# Platform sessions (run tools/dev/init_auth.py for the local bootstrap file).
# RISKGRAPH_BOOTSTRAP_PASSWORD_FILE=./tmp/local-auth/admin.password
RISKGRAPH_SECURE_COOKIE=false
# Verification clients default to admin and the generated local password file.
# RISKGRAPH_USERNAME=admin
# RISKGRAPH_PASSWORD_FILE=./tmp/local-auth/admin.password
# The optional docker-compose.ollama.yml defaults to qwen2.5:0.5b if OLLAMA_MODEL is unset.

# GitHub App / OAuth placeholders. Copy these names to the ignored `.env` file and
# put real values there. Keep the PEM outside this repository and reference its path.
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
GITHUB_APP_ID=replace_with_github_app_id
GITHUB_APP_PRIVATE_KEY_FILE=C:/path/to/riskgraph-github-app.pem
# Local-only launcher/Compose default. Production deployments must set true.
RISKGRAPH_REQUIRE_GITHUB_CONNECTION=false

# Optional comma-separated browser origins. Keep the OAuth return origin in DASHBOARD_ORIGIN.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
